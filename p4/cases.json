  "Q04": {
    "id": "Q04",
    "name": "hmo",
    "format": "hmo rd, rs, rt",
    "encoding_bits": "000000 rs rt rd 00000 110001",
    "original_bits": null,
    "original": null,
    "kind": "custom",
